# AI Job Copilot — Environment Configuration
# Copy this file: cp .env.example .env
# Then fill in your API keys.

# ── Required API Keys ─────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...          # console.anthropic.com
GEMINI_API_KEY=AIza...                # aistudio.google.com -> Get API Key
TAVILY_API_KEY=tvly-...               # app.tavily.com

# ── Per-task Model Routing ────────────────────────────────────────────────────
# Quality-critical -> Claude Sonnet (non-negotiable output quality)
MODEL_SCORE_FIT=claude-sonnet-4-20250514
MODEL_TAILOR_CV=claude-sonnet-4-20250514
MODEL_COVER_LETTER=claude-sonnet-4-20250514

# High-volume / structured -> Gemini 2.5 Flash (fast, cheap, great at JSON)
MODEL_PARSE_JOB=gemini-2.5-flash-preview-04-17
MODEL_SKILL_GAP=gemini-2.5-flash-preview-04-17
MODEL_INTERVIEW_PREP=gemini-2.5-flash-preview-04-17

# Fallback: if Gemini hits quota, fall back to Claude Sonnet automatically
ENABLE_FALLBACK=true
GEMINI_FALLBACK_MODEL=claude-sonnet-4-20250514

# ── Storage ───────────────────────────────────────────────────────────────────
DB_PATH=job_copilot.db
PDF_OUTPUT_DIR=outputs/pdfs

# ── Scoring Thresholds ────────────────────────────────────────────────────────
APPLY_THRESHOLD=70
MAYBE_THRESHOLD=45

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO

# ── Reliability ───────────────────────────────────────────────────────────────
MAX_RETRIES=2
RETRY_DELAY_SECONDS=2.0
